---
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
---
<header class="wiki-header" transition:persist="wiki-header">
  <a class="wiki-brand" href="/">Craft <span>Wiki</span></a>
  <nav aria-label="Main navigation" class="wiki-header-links">
    {/* Replacing Starlight's header dropped its search of the Pagefind index the build makes; keep it, as the strip's first cell. */}
    {config.pagefind && <div class="wiki-header-search"><Search /></div>}
    <a class="wiki-header-link wiki-header-browse" href="/#apps"><span>Browse apps</span></a>
    <a class="wiki-header-icon wiki-header-discord" href="https://discord.gg/artcraft" aria-label="Join the ArtCraft Discord" title="Join the ArtCraft Discord">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
        <path d="M19.7 5.1a18.1 18.1 0 0 0-4.5-1.4l-.6 1.2a16.6 16.6 0 0 0-5.2 0l-.6-1.2a18.1 18.1 0 0 0-4.5 1.4C1.4 9.3.6 13.4 1 17.5a18.2 18.2 0 0 0 5.5 2.8l1.2-2a11.6 11.6 0 0 1-1.8-.9l.4-.3a13 13 0 0 0 11.4 0l.4.3a11.6 11.6 0 0 1-1.8.9l1.2 2a18.2 18.2 0 0 0 5.5-2.8c.5-4.8-.8-8.9-3.3-12.4ZM8.6 15.1c-1.1 0-2-1-2-2.2s.9-2.2 2-2.2 2 1 2 2.2-.9 2.2-2 2.2Zm6.8 0c-1.1 0-2-1-2-2.2s.9-2.2 2-2.2 2 1 2 2.2-.9 2.2-2 2.2Z"/>
      </svg>
    </a>
    <button class="wiki-header-icon wiki-theme-toggle" type="button" aria-label="Switch to light theme" title="Switch theme">
      <svg class="wiki-icon-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/>
      </svg>
      <svg class="wiki-icon-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.9 13a9 9 0 0 1-9.9-9.9A9 9 0 1 0 20.9 13Z"/>
      </svg>
    </button>
    <a class="wiki-header-link wiki-header-edit" href="/edit/"><span>Edit wiki</span></a>
    <a class="wiki-header-cta" href="https://getartcraft.com">ArtCraft</a>
  </nav>
</header>
<script>
  // A search result's link carries the searched words, and the page it opens marks them with
  // Pagefind's own highlighter, which the build puts next to the index.
  const param = 'pagefind-highlight';
  // Stamp rendered URLs, not click events, so new-tab and context-menu navigation also
  // carry the terms. Observe only child changes to avoid reacting to our own href updates.
  const observedSearchRoots = new WeakSet<Element>();
  const connectSearchHighlights = () => {
    const root = document.querySelector('#starlight__search');
    if (!root || observedSearchRoots.has(root)) return;
    observedSearchRoots.add(root);
    const updateLinks = () => {
      const words = root.querySelector<HTMLInputElement>('input')?.value.trim().split(/\s+/).filter(Boolean) ?? [];
      for (const link of root.querySelectorAll<HTMLAnchorElement>('a.pagefind-ui__result-link[href]')) {
        const url = new URL(link.href);
        url.searchParams.delete(param);
        for (const word of words) url.searchParams.append(param, word);
        if (link.href !== url.href) link.href = url.href;
      }
    };
    root.addEventListener('input', updateLinks);
    new MutationObserver(updateLinks).observe(root, { childList: true, subtree: true });
    updateLinks();
  };
  connectSearchHighlights();
  document.addEventListener('astro:page-load', connectSearchHighlights);
  // The header persists across page loads, so mark each page as the router shows it.
  document.addEventListener('astro:page-load', () => {
    if (!new URLSearchParams(location.search).has(param)) return;
    const highlighter = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind/pagefind-highlight.js`;
    import(/* @vite-ignore */ highlighter).then(({ default: PagefindHighlight }) => new PagefindHighlight({ highlightParam: param, addStyles: false }));
  });
</script>

<script>
  const themeToggle = document.querySelector('.wiki-theme-toggle');
  if (themeToggle) {
    const root = document.documentElement;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let requestedTheme = root.dataset.theme === 'light' ? 'light' : 'dark';
    let themeTransition: ViewTransition | undefined;

    const updateThemeLabel = () => {
      const nextTheme = root.dataset.theme === 'light' ? 'dark' : 'light';
      themeToggle.setAttribute('aria-label', `Switch to ${nextTheme} theme`);
      themeToggle.setAttribute('title', `Switch to ${nextTheme} theme`);
    };

    themeToggle.addEventListener('click', () => {
      requestedTheme = requestedTheme === 'light' ? 'dark' : 'light';
      const applyTheme = () => {
        root.dataset.theme = requestedTheme;
        try { localStorage.setItem('wiki-theme', requestedTheme); } catch { /* Private browsing can block storage. */ }
        updateThemeLabel();
      };

      themeTransition?.skipTransition();
      if (reducedMotion.matches || !document.startViewTransition) {
        applyTheme();
        return;
      }

      root.dataset.wikiThemeTransition = '';
      const transition = document.startViewTransition(applyTheme);
      themeTransition = transition;
      const finish = () => {
        if (themeTransition !== transition) return;
        themeTransition = undefined;
        delete root.dataset.wikiThemeTransition;
      };
      void transition.finished.then(finish, finish);
    });
    updateThemeLabel();
  }
</script>
