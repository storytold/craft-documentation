---
import { apps, appCategories, thirdPartyApps } from '../data/apps.mjs';
import WikiAppName from './WikiAppName.astro';
import WikiGuideLinks from './WikiGuideLinks.astro';
const pathname = Astro.url.pathname;
const appBySlug = Object.fromEntries(apps.map((app) => [app[0], app]));
---
<div class="wiki-sidebar-inner" transition:persist="wiki-sidebar">
  <label class="wiki-search-label" for="wiki-app-search">Filter apps</label>
  <input id="wiki-app-search" type="search" placeholder="Filter apps..." autocomplete="off" />
  <a href="/" class:list={['wiki-home-link', { active: pathname === '/' }]}><span>All documentation</span></a>
  <p class="wiki-sidebar-label">OFFICIAL APPS</p>
  <div class="wiki-official-apps">
    {appCategories.map(([category, slugs]) => (
      <>
        <p class="wiki-sidebar-category">{category}</p>
        <div class="wiki-app-list">
          {slugs.map((slug) => appBySlug[slug]).map(([slug, name, ext = 'webp']) => (
            <details class="wiki-app-group" data-name={name.toLowerCase()} open={pathname.startsWith(`/apps/${slug}/`)}>
              <summary><img src={`/assets/apps/${slug}.${ext}`} alt="" /><span><WikiAppName slug={slug} name={name} /></span><span class="wiki-chevron" aria-hidden="true"></span></summary>
              <WikiGuideLinks slug={slug} />
            </details>
          ))}
        </div>
      </>
    ))}
  </div>
  <p class="wiki-sidebar-label">THIRD-PARTY APPS</p>
  <div id="wiki-thirdparty-app-list">
    {thirdPartyApps.map(([slug, name, ext = 'webp']) => (
      <details class="wiki-app-group" data-name={name.toLowerCase()} open={pathname.startsWith(`/apps/${slug}/`)}>
        <summary><img src={`/assets/apps/${slug}.${ext}`} alt="" /><span><WikiAppName slug={slug} name={name} /></span><span class="wiki-chevron" aria-hidden="true"></span></summary>
        <WikiGuideLinks slug={slug} />
      </details>
    ))}
  </div>
  <p id="wiki-no-results" hidden>No apps found.</p>
</div>
<script>
  const search = document.querySelector<HTMLInputElement>('#wiki-app-search');
  const groups = document.querySelectorAll<HTMLElement>('.wiki-app-group');
  const labels = document.querySelectorAll<HTMLElement>('.wiki-sidebar-label, .wiki-sidebar-category');
  const noResults = document.querySelector<HTMLElement>('#wiki-no-results');
  function updateCurrentPage() {
    const path = location.pathname;
    document.querySelector('.wiki-home-link')?.classList.toggle('active', path === '/');
    document.querySelectorAll<HTMLAnchorElement>('.wiki-guide-links a').forEach(link => {
      const active = link.pathname === path;
      if (active) {
        link.setAttribute('aria-current', 'page');
        let parent = link.parentElement;
        while (parent && !parent.classList.contains('wiki-sidebar-inner')) {
          if (parent instanceof HTMLDetailsElement) parent.open = true;
          parent = parent.parentElement;
        }
      } else link.removeAttribute('aria-current');
    });
  }
  document.addEventListener('astro:page-load', updateCurrentPage);
  updateCurrentPage();
  search?.addEventListener('input', () => {
    const query = search.value.trim().toLowerCase();
    let visible = 0;
    groups.forEach((group) => {
      const matches = (group.dataset.name ?? '').includes(query);
      group.hidden = !matches;
      if (matches) visible++;
    });
    labels.forEach((label) => {
      const list = label.nextElementSibling;
      if (list) {
        const hasVisible = !!list.querySelector('.wiki-app-group:not([hidden])');
        label.hidden = !hasVisible;
      }
    });
    if (noResults) noResults.hidden = visible > 0;
  });
</script>
